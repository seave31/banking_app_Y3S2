<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base text style -->
    <style name="Widget.BankingApp.CleanTextView" parent="@android:style/Widget.TextView">
        <item name="android:shadowColor">@android:color/transparent</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowRadius">0</item>
        <item name="android:elegantTextHeight">false</item>
    </style>

    <!-- Refined Bottom Nav Styling -->
    <style name="Widget.BankingApp.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.BankingApp.BottomNavIndicator</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="labelVisibilityMode">unlabeled</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
    </style>

    <style name="Widget.BankingApp.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <!-- Solid Teal Indicator for high-end contrast -->
        <item name="android:color">@color/primary</item>
        <item name="android:width">48dp</item>
        <item name="android:height">38dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.BankingApp.NavIndicator</item>
    </style>

    <style name="ShapeAppearance.BankingApp.NavIndicator" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">19dp</item>
    </style>

    <style name="ShapeAppearance.BankingApp.Circle" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>