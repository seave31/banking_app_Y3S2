<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <!-- Avatar -->
    <TextView
        android:id="@+id/counterPartyAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_avatar"
        android:gravity="center"
        android:text="JD"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Type -->
    <TextView
        android:id="@+id/directionalLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="TRANSFER"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/counterPartyAvatar"
        app:layout_constraintTop_toTopOf="@id/counterPartyAvatar"
        app:layout_constraintEnd_toStartOf="@id/icon_iv"/>

    <!-- Name -->
    <TextView
        android:id="@+id/counterPartyNameTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="John · ···3456"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@id/directionalLabel"
        app:layout_constraintTop_toBottomOf="@id/directionalLabel"
        app:layout_constraintEnd_toStartOf="@id/icon_iv"/>

    <!-- Icon -->
    <ImageView
        android:id="@+id/icon_iv"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:background="@drawable/bg_soft_icon_green"
        android:src="@android:drawable/arrow_up_float"
        android:tint="@color/soft_green_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Amount -->
    <TextView
        android:id="@+id/amountTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$120.00"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/counterPartyAvatar"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintTop_toBottomOf="@id/amountTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Transaction ID Label -->
    <TextView
        android:id="@+id/transactionIdLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/transaction_id"
        android:textSize="11sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Transaction ID Value -->
    <TextView
        android:id="@+id/transactionIdTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TXN123456"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/transactionIdLabel"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Date Label (NOW BELOW ID) -->
    <TextView
        android:id="@+id/dateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/date"
        android:textAllCaps="true"
        android:textSize="11sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/transactionIdTv"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Date Value -->
    <TextView
        android:id="@+id/dateTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12 Apr 2026"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/dateLabel"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Remark Label -->
    <TextView
        android:id="@+id/remarkLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/remark"
        android:textAllCaps="true"
        android:textSize="11sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/dateTv"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Remark Value -->
    <TextView
        android:id="@+id/remarkTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payment for lunch"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/remarkLabel"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveBtn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/save_as_image"
        android:textAllCaps="false"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:icon="@drawable/icon_save_alt_24"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/remarkTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>