<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/bg_dashboard_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_badge">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_attach_money_24"
                app:tint="@color/brass_gold" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/send_money"
            android:textColor="@color/off_white"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Ledger balance card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ledger_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/available_balance"
                    android:textAllCaps="true"
                    android:textColor="@color/muted_slate"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/balance_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:fontFamily="monospace"
                    android:text="$2,480.35"
                    android:textColor="@color/off_white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Perforated tear line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layerType="software"
                    android:background="@drawable/divider_dashed" />
            </LinearLayout>

            <!-- Recipient -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/acc_no"
                android:textColor="@color/textColor"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/account_number_et"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@drawable/ic_account_balance_wallet_24"
                android:drawableTint="@color/brass_gold"
                android:drawablePadding="10dp"
                android:hint="ACC 000 000"
                android:paddingHorizontal="14dp"
                android:textColor="@color/textColor"
                android:textColorHint="@color/muted_slate"
                android:textSize="14sp" />

            <!-- Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/amount"
                android:textColor="@color/off_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="$"
                    android:textColor="@color/brass_gold"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/amount_et"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="monospace"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:paddingStart="6dp"
                    android:textColor="@color/textColor"
                    android:textColorHint="@color/muted_slate"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Quick amount coin chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacingHorizontal="8dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/usd_10_chip"
                    style="@style/CoinChip"
                    android:text="$10" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/usd_25_chip"
                    style="@style/CoinChip"
                    android:text="$25" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/usd_50_chip"
                    style="@style/CoinChip"
                    android:text="$50" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/usd_100_chip"
                    style="@style/CoinChip"
                    android:text="$100" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Note -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/note_optional"
                android:textColor="@color/off_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/remark_et"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:hint="@string/payment_note_hint"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="@color/textColor"
                android:textColorHint="@color/muted_slate"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/send_money_btn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:elevation="1dp"
                android:backgroundTint="@color/card_navy"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/continue_text"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:iconGravity="textEnd" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>